NODE_ENV=development
SERVICE_NAME=flourist-api

HOST=0.0.0.0
PORT=8787
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:4321
TRUST_PROXY=false

LOG_LEVEL=info

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# Supabase → Connect → Session pooler (port 5432), used for migrations
DATABASE_MIGRATION_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=10
DATABASE_SSL=true
DATABASE_SSL_CA=

# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
